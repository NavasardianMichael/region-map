{
  "name": "@regionify/marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-assets.js && astro dev",
    "build": "node scripts/copy-assets.js && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "generate-assets": "tsx scripts/playwright-asset-generator.ts",
    "generate-marketing-screenshots": "tsx scripts/playwright-marketing-screenshots.ts",
    "generate-demo-video": "tsx scripts/playwright-demo-video.ts",
    "generate-demo-video-sample-data": "tsx scripts/playwright-demo-video-sample-data.ts",
    "generate-demo-video-italy-ai-parser": "tsx scripts/playwright-demo-video-italy-ai-parser.ts",
    "generate-demo-video-india": "tsx scripts/playwright-demo-video-india.ts",
    "generate-demo-video-india-export": "tsx scripts/playwright-demo-video-india-export.ts",
    "generate-reddit-coolguide-driving-side": "tsx scripts/playwright-reddit-coolguide-driving-side.ts",
    "postinstall": "node -e \"require('child_process').execSync('node install.js',{cwd:require('path').dirname(require.resolve('ffmpeg-static/package.json')),stdio:'inherit'})\""
  },
  "dependencies": {
    "@regionify/shared": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^5.7.0",
    "dotenv": "^16.5.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.2"
  }
}
